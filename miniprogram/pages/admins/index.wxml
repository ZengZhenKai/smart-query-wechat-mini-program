<view class="page"><view class="card"><view class="title">管理员</view><view wx:for="{{admins}}" wx:key="_id" class="list-item row"><view><view>{{item.displayCode}} {{item.displayName}}</view><view class="muted">{{item.role}}</view></view><button wx:if="{{item.role==='admin'}}" class="btn btn-small btn-danger" data-id="{{item._id}}" data-role="user" bindtap="change">取消管理员</button></view></view>
<view class="card"><view class="title">可设为管理员的员工</view><view wx:for="{{users}}" wx:key="_id" class="list-item row"><view><view>{{item.displayCode}} {{item.displayName}}</view><view class="muted">普通员工</view></view><button class="btn btn-small" data-id="{{item._id}}" data-role="admin" bindtap="change">设为管理员</button></view><view wx:if="{{loaded && !users.length}}" class="empty">暂无可选员工</view></view><view class="site-footer">智慧查询，版权所有</view></view>
