.top { margin-bottom:26rpx; }.top .title{margin:0}.mine{margin:0;background:#fff;color:#078848;font-size:26rpx;border:2rpx solid #bfe8ce}.mine::after{border:0}.search-row{display:flex;gap:16rpx}.search{flex:1;background:#f8fcf9;border:2rpx solid #cfe9d8;padding:20rpx;border-radius:12rpx}.search-btn{width:150rpx;background:#07c160;color:#fff;margin:0}.search-btn::after{border:0}.result{border-left:8rpx solid #07c160}.code-row{align-items:flex-start}.test-code{font-size:46rpx;font-weight:800;color:#17643d;line-height:1.35;white-space:pre-wrap;word-break:break-all;flex:1}.no-code{font-size:34rpx;color:#7a8492}.product{font-size:31rpx;font-weight:600;line-height:1.5;flex:1;word-break:break-all}.divider{height:1rpx;background:#e5eee8;margin:28rpx 0}.result-bottom{display:flex;align-items:flex-end;justify-content:space-between;gap:20rpx;margin-top:26rpx}.assembly{display:flex;align-items:baseline;flex:1;min-width:0;flex-wrap:wrap}.assembly-label{color:#3f4b44;font-size:30rpx;font-weight:700}.assembly-code{color:#078848;font-size:42rpx;font-weight:800;line-height:1.15;word-break:break-all}.product-copy{flex:none;align-self:flex-end}
.exact-badge{display:inline-block;background:#e7f6ec;color:#18753c;border-radius:999rpx;padding:6rpx 16rpx;font-size:23rpx;margin-bottom:20rpx}
.image-section-title{font-size:30rpx;font-weight:700;color:#344139;margin-bottom:18rpx}.product-image-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}.product-image-slot{width:100%;aspect-ratio:1/1;border-radius:14rpx;overflow:hidden;background:#f3f7f4;border:2rpx solid #dce9e0}.product-image{display:block;width:100%;height:100%}.product-image-placeholder{display:flex;align-items:center;justify-content:center;width:100%;height:100%;color:#8a958e;font-size:26rpx;background:#f4f7f5}
