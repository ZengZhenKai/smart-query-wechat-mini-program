.profile-head{display:flex;align-items:center;gap:28rpx}.avatar{width:116rpx;height:116rpx;border-radius:50%;background:#f2fbf5}.info{flex:1;min-width:0}.profile-name{font-size:34rpx;font-weight:700;margin-bottom:10rpx;word-break:break-all}.avatar-button{width:136rpx;height:136rpx;border-radius:50%;padding:8rpx;overflow:hidden;background:#e9f8ef;border:2rpx solid #07c160;box-shadow:0 7rpx 20rpx rgba(7,193,96,.14);display:flex;align-items:center;justify-content:center;margin:0;flex:none}.avatar-button::after{border:0}.avatar-placeholder{width:116rpx;height:116rpx;border-radius:50%;background:#f2fbf5;color:#078848;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:21rpx;line-height:1.1}.avatar-plus{font-size:34rpx}.edit-label{margin-top:32rpx}
