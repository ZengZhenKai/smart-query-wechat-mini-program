.warning{border-left:8rpx solid #d97706;line-height:1.7}.danger-text{color:#b42318;font-weight:700;margin-top:12rpx}.file-name{margin-top:20rpx;padding:20rpx;background:#f2fbf5;border-radius:10rpx;word-break:break-all}.stat{display:flex;justify-content:space-between;gap:20rpx;padding:18rpx 0;border-bottom:1rpx solid #e5eee8}.stat text:last-child{font-weight:700}.good{color:#078848}.changed{color:#078848}.bad{color:#b42318}.detail-link{padding:24rpx 0;cursor:pointer}.details-panel{margin:0 -8rpx 16rpx;padding:8rpx 16rpx 16rpx;background:#f7fbf8;border-radius:12rpx}.update-panel{background:#effaf3}.error-panel{background:#fff5f4}.detail-item{padding:20rpx 8rpx;border-bottom:1rpx solid #dce9e1;line-height:1.6;word-break:break-all}.detail-item:last-child{border-bottom:0}.compact-item{display:block}.detail-code{font-size:30rpx;font-weight:700;color:#26332c;margin-bottom:6rpx}.value-line,.change-line{white-space:pre-wrap}.field-label{font-weight:600}.old-value{color:#667085;text-decoration:line-through}.arrow{color:#667085}.new-value{color:#078848;font-weight:600}.blank-protected{margin-top:10rpx;padding:10rpx 14rpx;background:#e9f8ef;color:#067647;border-radius:8rpx;font-size:24rpx}.error-item{color:#b42318}.reason{font-weight:700}.empty-detail{padding:20rpx;color:#667085;text-align:center}.more-btn{margin-top:16rpx;background:#fff!important;color:#078848!important;border:1rpx solid #bfe8ce;font-size:26rpx}.more-btn::after{border:0}.error-list{margin-top:18rpx;padding:18rpx;background:#fff1f0;color:#b42318;border-radius:10rpx;line-height:1.6;word-break:break-all}.safe-notice{margin-top:22rpx;padding:18rpx;background:#e9f8ef;color:#067647;border-radius:10rpx;font-weight:600;line-height:1.6}.keep-notice{margin:24rpx 0;color:#b42318;font-weight:700;line-height:1.6}.result-card view{margin-bottom:16rpx}
