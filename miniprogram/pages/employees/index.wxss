.tabs{display:flex;padding:10rpx}.tabs button{flex:1;background:#fff;font-size:25rpx;padding:10rpx}.tabs button::after{border:0}.tabs .active{background:#07c160;color:#fff}.name{font-weight:700;font-size:32rpx}.actions{display:flex;gap:16rpx;margin-top:24rpx}.actions button{flex:1}
.permission-panel{margin-top:24rpx;padding:22rpx;border-radius:14rpx;background:#f2fbf5}.permission-title{font-weight:700;margin-bottom:10rpx}.permission-row{display:flex;align-items:center;justify-content:space-between;padding:12rpx 0;font-size:27rpx}
.permission-saving{padding-top:8rpx;text-align:right}
