<view class="page">
  <view class="card tabs"><button wx:for="{{tabs}}" wx:key="value" class="{{status===item.value?'active':''}}" data-status="{{item.value}}" bindtap="switchTab">{{item.label}}</button></view>
  <view wx:if="{{!users.length}}" class="empty">当前没有{{statusText}}员工</view>
  <view wx:for="{{users}}" wx:key="_id" class="card"><view class="row"><view><view class="name">{{item.displayName}}</view><view class="muted">{{item.identityText}}</view></view><text class="status">{{statusText}}</text></view>
    <view class="actions" wx:if="{{status==='pending'}}"><button class="btn btn-small" data-id="{{item._id}}" data-status="approved" bindtap="review">通过</button><button class="btn btn-small btn-secondary" data-id="{{item._id}}" data-status="rejected" bindtap="review">拒绝</button></view>
    <view wx:if="{{item.showPermissionControls}}" class="permission-panel">
      <view class="permission-title">功能权限</view>
      <view class="permission-row"><text>图片维护</text><switch checked="{{item.canUploadImages}}" disabled="{{!!savingId}}" data-index="{{index}}" data-field="canUploadImages" bindchange="togglePermission" color="#07c160"/></view>
      <view class="permission-row"><text>修改总成编号</text><switch checked="{{item.canEditAssemblyCode}}" disabled="{{!!savingId}}" data-index="{{index}}" data-field="canEditAssemblyCode" bindchange="togglePermission" color="#07c160"/></view>
      <view wx:if="{{savingId===item._id}}" class="muted permission-saving">正在更新权限…</view>
    </view>
    <button wx:if="{{item.role!=='super_admin'}}" class="btn btn-danger" data-id="{{item._id}}" data-name="{{item.displayName}}" bindtap="remove">删除员工</button>
  </view>
  <view class="site-footer">智慧查询，版权所有</view>
</view>
