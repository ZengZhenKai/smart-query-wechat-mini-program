.area { width:100%; box-sizing:border-box; min-height:130rpx; }.large { min-height:220rpx; }
.limited-note{margin:6rpx 0 18rpx;line-height:1.6}
.image-manager-title{font-size:34rpx;font-weight:700;color:#25332b}.image-manager-note{margin:8rpx 0 24rpx}.image-manager-empty{margin-top:20rpx}.image-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx}.image-admin-slot{min-width:0}.image-frame{position:relative;width:100%;aspect-ratio:1/1;border-radius:14rpx;overflow:hidden;background:#f3f7f4;border:2rpx solid #dce9e0}.model-image{width:100%;height:100%;display:block}.image-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#8a958e;font-size:26rpx;background:#f4f7f5}.slot-label{position:absolute;left:10rpx;top:10rpx;padding:4rpx 10rpx;border-radius:999rpx;background:rgba(255,255,255,.9);color:#3e4b43;font-size:22rpx}.image-actions{display:flex;gap:12rpx;margin-top:12rpx}.image-action{flex:1;min-width:0}
