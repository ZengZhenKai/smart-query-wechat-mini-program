.boot-page{min-height:100vh;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48rpx;background:linear-gradient(180deg,#effbf3 0%,#f8fcf9 100%);color:#26332c}.brand-mark{width:132rpx;height:132rpx;border-radius:36rpx;background:#07c160;color:#fff;display:flex;align-items:center;justify-content:center;font-size:42rpx;font-weight:700;letter-spacing:4rpx;box-shadow:0 14rpx 34rpx rgba(7,193,96,.22)}.brand-name{margin-top:34rpx;font-size:46rpx;font-weight:700;letter-spacing:8rpx}.brand-subtitle{margin-top:16rpx;color:#728078;font-size:25rpx;letter-spacing:4rpx}.boot-status{margin-top:44rpx;color:#728078;font-size:26rpx}.boot-error{width:100%;margin-top:40rpx;text-align:center}.error-title{color:#d14343;font-size:30rpx;font-weight:600}.error-message{display:block;margin-top:16rpx;color:#59665f;font-size:24rpx;line-height:1.6;word-break:break-all}.retry-button{width:240rpx;margin-top:28rpx;background:#07c160!important;color:#fff!important;border-radius:12rpx;font-size:28rpx}
