<view class="page"><view class="card"><view class="search-row"><input class="field" value="{{keyword}}" placeholder="总成编号或商品名称" bindinput="input" bindconfirm="load"/><button class="btn btn-small" bindtap="load">搜索</button></view><button wx:if="{{isAdmin}}" class="btn" bindtap="create">新增型号</button><button wx:if="{{canImport}}" class="btn btn-secondary" bindtap="importExcel">Excel批量导入</button></view>
<view wx:for="{{models}}" wx:key="_id" class="card"><view class="row"><view><view class="name">{{item.assemblyCode}}</view><view class="muted">{{item.productName}}</view></view><button wx:if="{{canMaintain}}" class="btn btn-small btn-secondary" data-model="{{item}}" bindtap="edit">维护</button></view><view class="code">{{item.testCode || '暂无测试编码'}}</view><button wx:if="{{isAdmin}}" class="btn btn-danger" data-id="{{item._id}}" data-code="{{item.assemblyCode}}" bindtap="remove">删除</button></view><view class="site-footer">智慧查询，版权所有</view></view>
