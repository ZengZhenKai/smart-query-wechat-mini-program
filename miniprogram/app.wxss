page { background:#f2fbf5; color:#2b2f33; font-size:30rpx; }
.page { padding:32rpx; box-sizing:border-box; min-height:100vh; display:flex; flex-direction:column; }
.card { background:#fff; border-radius:18rpx; padding:30rpx; margin-bottom:24rpx; box-shadow:0 5rpx 20rpx rgba(22,87,52,.07); }
.title { font-size:38rpx; font-weight:700; margin-bottom:18rpx; }
.muted { color:#6f7873; font-size:26rpx; }
.danger { color:#b42318; }
.btn { margin-top:22rpx; background:#07c160; color:#fff; border-radius:12rpx; font-size:30rpx; }
.btn::after { border:0; }
.btn-secondary { background:#e9f8ef; color:#078848; }
.btn-danger { background:#c62828; color:#fff; }
.btn-small { margin:0; padding:0 22rpx; min-width:128rpx; line-height:66rpx; font-size:26rpx; }
.field { background:#f8fcf9; border:2rpx solid #cfe9d8; border-radius:12rpx; padding:22rpx; margin:12rpx 0 24rpx; color:#2b2f33; }
.label { font-size:26rpx; color:#5f6d65; }
.row { display:flex; align-items:center; justify-content:space-between; gap:18rpx; }
.empty { text-align:center; color:#6f7873; padding:80rpx 20rpx; line-height:1.7; }
.status { display:inline-block; border-radius:999rpx; padding:5rpx 16rpx; background:#e9f8ef; color:#078848; font-size:24rpx; }
.list-item { padding:24rpx 0; border-bottom:1rpx solid #e5eee8; }
.list-item:last-child { border-bottom:0; }
.site-footer { margin-top:auto; padding:38rpx 0 12rpx; text-align:center; color:#8a9690; font-size:23rpx; letter-spacing:2rpx; }
